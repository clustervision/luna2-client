{
  "version": 2,
  "sets": [
    {
      "name": "os", "role": "os", "selection": "manual", "raid": "none",
      "devices": ["/dev/sda"],
      "volumes": [
        {"name": "uefi", "mountpoint": "/boot/efi", "fs": "vfat", "provider": "partition", "size": "600M"},
        {"name": "boot", "mountpoint": "/boot", "fs": "xfs", "provider": "partition", "size": "1G"},
        {"name": "swap", "mountpoint": "swap", "fs": "swap", "provider": "partition", "size": "2G"},
        {"name": "root", "mountpoint": "/", "fs": "xfs", "provider": "partition", "size": "100%"}
      ]
    }
  ]
}
