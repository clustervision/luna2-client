PREREQ=""

# Output pre-requisites
prereqs()
{
        echo "$PREREQ"
}

case $1 in
# get pre-requisites
prereqs)
        prereqs
        exit 0
        ;;
esac

echo
echo "Welcome to Luna Installer"

#
# This function exists in Dracut but not in initramfs-tools, so we add
# it here for compatibility.
#
getargs() {
    local o line found
    [ "$CMDLINE" ] || read CMDLINE </proc/cmdline;
    for o in $CMDLINE; do
        [ "$o" = "$1" ] && return 0
        if [ "${o%%=*}" = "${1%=}" ]; then
            echo -n "${o#*=}";
            found=1;
        fi
    done
    [ -n "$found" ] && return 0
    return 1
}

are_macs_equal() {
    awk -v mac=$1 -v reqmac=$2 'BEGIN{
        if (length(mac) == 17) {
            if (mac == reqmac) {
                print 1
            } else {
                print 0
            }
        } else {
            mac_len = split(mac, mac_array, ":")
            reqmac_len = split(reqmac, reqmac_array, ":")
            j=reqmac_len
            for (i=mac_len; i>0; i--) {
                if ((j>0) && (mac_array[i] == reqmac_array[j])) {
                    j--
                }
            }
            if (j==0) {
                print 1
            } else {
                print 0
            }
        }

    }'
}

find_nic() {
    REQMAC=$1
    for NIC in /sys/class/net/*; do
        IFNAME=$(basename ${NIC})
        if [ "x${IFNAME}" = "xlo" ]; then
            continue
        fi
        MAC=$(cat ${NIC}/address)
        if [ "$(are_macs_equal $MAC $REQMAC)" -eq 1 ]; then
            echo ${IFNAME}
            break
        fi
    done
}

luna_init() {
    if [ ! -d /lunatmp ]; then
        mkdir /lunatmp
    fi
}

luna_start() {
    local luna_ip
    local luna_gw
    local luna_bootproto
    local luna_mac
    echo "$(getargs luna.hostname=)" > /proc/sys/kernel/hostname
    # The dhcpcd hook replaces /etc/passwd with its own line only; without root
    # every ssh key is refused for a user that does not exist.
    grep -q '^root:' /etc/passwd 2>/dev/null || echo 'root:x:0:0:root:/:/bin/sh' >> /etc/passwd
    # dropbear first, as in the dracut hook: one self-contained binary that makes
    # its own host keys and needs no privilege-separation dir. sshd only without it.
    if [ -x /usr/sbin/dropbear ]; then
        echo "Luna2: Starting ssh (dropbear)"
        mkdir -p /etc/dropbear
        /usr/sbin/dropbear -R -p 22 || echo "Luna2: dropbear did not start: no ssh into this ramdisk"
    else
        echo "Luna2: Starting ssh"
        echo "sshd:x:74:74:Privilege-separated SSH:/var/empty/sshd:/sbin/nologin" >> /etc/passwd
        echo sshd:x:74: >> /etc/group
        # Debian's sshd refuses to start without /run/sshd (its privilege-separation dir).
        mkdir -p /var/empty/sshd /run/sshd
        /usr/sbin/sshd > /dev/null 2>&1 || echo "Luna2: sshd did not start: no ssh into this ramdisk"
    fi
    echo "Luna2: Start shell on tty2"
    luna_ctty2=/dev/tty2
    setsid -c /bin/sh -i -l 0<>$luna_ctty2 1<>$luna_ctty2 2<>$luna_ctty2 &
    udevadm settle
    # settle is not really reliable
    sleep 5
    echo "Luna2: Set-up network"
    luna_bootproto=$(getargs luna.bootproto=)
    luna_mac=$(getargs luna.mac=)
    echo "Luna2: Trying to find interface for ${luna_mac}"
    luna_nic=$(find_nic ${luna_mac})
    echo "${luna_nic}" > /lunatmp/luna_nic
    export LUNA_BOOTIF="${luna_nic}"
    if [ "x$luna_bootproto" = "xdhcp" ]; then
        echo "Luna2: Configuring dhcp for all interfaces"
        /usr/sbin/dhclient -lf /lunatmp/dhclient.leases
    else
        luna_ip=$(getargs luna.ip=)
        luna_gw=$(getargs luna.gw=)
        echo "Luna2: ${luna_ip} for interface with mac ${luna_mac} was specified"
        if [ "x${luna_nic}" = "x" ]; then
            echo "Luna2: unable to find NIC for mac ${luna_mac}. Starting dhcp"
            /usr/sbin/dhclient -lf /lunatmp/dhclient.leases
        else
            ip a add ${luna_ip} dev ${luna_nic}
            sleep 1
            ip l set dev ${luna_nic} up
	    if [ ! "x${luna_gw}" = "x" ]; then
                sleep 1
                echo "Luna2: setting default gateway ${luna_gw}"
                ip route add default via ${luna_gw} dev ${luna_nic}
            fi
        fi
    fi
}

luna_finish() {
    # -P 514: without a port logger resolves the service name "syslog", which
    # needs /etc/services -- absent from the initramfs, so every forward
    # failed ("Servname not supported") and the controller never saw this log
    luna_loghost=$(getargs luna.loghost=)
    if [ "$luna_loghost" ]; then
        logger -d -n "$luna_loghost" -P 514 < /tmp/luna_install.log
    else
        echo "Luna2: loghost not defined, cannot forward logs."
    fi
    # shutdown sshd
#   ps -h not available in busybox
#    /usr/bin/ps h --ppid `cat /var/run/sshd.pid` -o 'pid' | while read pid; do kill $pid; done
#    kill `cat /var/run/sshd.pid`
    # shutdown dhclient
    /usr/sbin/dhclient -lf /lunatmp/dhclient.leases -x
    # bring interfaces down
    if [ -f /lunatmp/luna_nic ]; then
        luna_nic=$(cat /lunatmp/luna_nic)
        ip addr flush ${luna_nic}
        ip link set dev ${luna_nic} down
    else
        cat /lunatmp/dhclient.leases  | \
            sed -n '/interface /s/\W*interface "\(.*\)";/\1/p' | \
            while read iface; do
                ip addr flush $iface
                ip link set dev $iface down
            done
    fi
    # initramfs-tools mounts the new root at $rootmnt (/root), not /sysroot:
    # the move to /sysroot failed on every node and the log was lost
    mv /tmp/luna_install.log "${rootmnt:-/root}/var/log/"
    # kill shell on tty2
    ps h t tty2 o pid | while read pid; do kill -9 $pid; done

}

# Without luna.ctty: the last console= on the command line (the kernel's
# /dev/console), else tty1 -- a park shell on tty1 is invisible on a
# serial-console node. Same rule as 95luna's luna-installer.sh.
# POSIX sh only (no arrays): initramfs-tools runs `sh -n` (dash) over every
# boot script while building the initramfs and silently leaves out any
# script that fails it -- the node then boots to "No init found".
_get_luna_ctty() {
    local luna_ctty _o _c=""
    luna_ctty=$(getargs luna.ctty=)
    if [ -z "${luna_ctty}" ]; then
        for _o in $(cat /proc/cmdline 2>/dev/null); do
            case "$_o" in console=*) _c="${_o#console=}"; _c="${_c%%,*}" ;; esac
        done
        [ "$_c" = "tty0" ] && _c=tty1
        [ -n "$_c" ] && [ -c "/dev/${_c#/dev/}" ] && luna_ctty="/dev/${_c#/dev/}"
    fi
    [ -n "${luna_ctty}" ] || luna_ctty="/dev/tty1"
    printf '%s' "$luna_ctty"
}

# lpart writes the failing stage + reason here; the tmpfs survives retries,
# so it is cleared before every attempt (as is the sanitize marker).
LUNA_FAILURE_FILE=/tmp/install_files/logs/last-failure.txt
LUNA_SANITIZE_MARKER=/tmp/install_files/runtime/sanitize.done
LUNA_FATAL_RC=3   # keep in sync with lpart-node-installer exitFatalConfig
LUNA_SAFETY_RC=2  # keep in sync with internal/cli ExitSafetyRefusal

# luna_report <file>: print a final report on the console (and into the install
# log through tee) and send the install log plus the report to the loghost.
# The report is sent ON ITS OWN as well: the install log reaches the loghost only
# through the file tee writes, and on a slow console (serial, 115200 baud) tee
# lags behind by up to two pipe buffers, so the lines printed just before the
# forward -- the reason a node parks or what sanitize erased -- were missing.
luna_report() {
    cat "$1"
    if [ "$luna_loghost" ]; then
        logger -d -n "$luna_loghost" -P 514 < /tmp/luna_install.log   # as far as tee got
        logger -d -n "$luna_loghost" -P 514 < "$1"
    fi
}

# The install script reported where it stopped with a token issued when it
# started, which a long erase outlives: report that state again with a fresh one.
luna_post_state() {
    local _token
    _token=$(fetch_token 2>/dev/null)
    [ -n "$_token" ] && [ "$_token" != "None" ] || return 0
    luna_curl -s -m 10 -X POST -H "x-access-tokens: $_token" -H "Content-Type: application/json" \
        -d '{"monitor": {"status": {"'"$luna_node"'": {"state": "'"$1"'"}}}}' \
        "${luna_url}/monitor/node/${luna_node}" > /dev/null 2>&1
}

# The state the install template reported for lpart's park exit (lpart_phase).
lpart_park_state() {
    if [ "$1" = "$LUNA_SAFETY_RC" ]; then
        [ -f /tmp/install_files/runtime/degraded.done ] && echo install.degraded || echo install.refused
    else
        echo install.fatal
    fi
}

# install_mode=sanitize finished: report what lpart-storage-prepare reported
# (the marker content) and park -- a retry would only erase again.
luna_sanitize_stop() {
    local _line _r=/lunatmp/luna-report.txt
    {
        echo "Luna2: SANITIZE FINISHED -- lpart-storage-prepare reported:"
        if [ -s "$LUNA_SANITIZE_MARKER" ]; then
            while IFS= read -r _line || [ -n "$_line" ]; do echo "Luna2:   ${_line}"; done < "$LUNA_SANITIZE_MARKER"
        else
            echo "Luna2:   (no report was written -- check the install log)"
        fi
        echo "Luna2: install_mode=sanitize stops the node here (install.sh rc=$1):"
        echo "Luna2: set another install_mode, then reboot the node."
        echo "Luna2: 'poweroff' stops the node; exiting the shell re-opens it (no retry)."
    } > "$_r"
    luna_report "$_r"
    luna_post_state install.sanitized
    sync
    while true; do
        if { exec 9<>"$luna_ctty"; } 2>/dev/null; then
            exec 9<&-
            setsid -c /bin/sh -i -l 0<>"$luna_ctty" 1<>"$luna_ctty" 2<>"$luna_ctty"
        else
            sleep 3600
        fi
    done
}

# install.sh exit 2 (safety refusal) or 3 (non-retryable config error) recurs
# on every attempt: show the reason, park in a shell, never retry.
fatal_park() {
    local _kind _r=/lunatmp/luna-report.txt
    {
        echo "Luna2: ============================================================"
        echo "Luna2: INSTALL FAILED (exit $1) -- NOT retrying."
        if [ -s "$LUNA_FAILURE_FILE" ]; then
            print_failure_reason
            case "$1" in
                "$LUNA_SAFETY_RC") _kind="a safety refusal" ;;
                *) _kind="a non-retryable configuration error" ;;
            esac
            echo "Luna2: lpart reported the reason above: ${_kind}, which would recur on"
            echo "Luna2: every attempt."
        else
            echo "Luna2: The install script exited $1 (operator script or install step);"
            echo "Luna2: see the log."
        fi
        echo "Luna2: Exit 2 and 3 are non-retryable, so the node is parked instead of"
        echo "Luna2: reinstalling in a loop."
        echo "Luna2: 'poweroff' stops the node; exiting the shell re-opens it (no retry)."
        echo "Luna2: ============================================================"
    } > "$_r"
    luna_report "$_r"
    if [ -s "$LUNA_FAILURE_FILE" ]; then
        luna_post_state "$(lpart_park_state "$1")"
    fi
    while true; do
        if { exec 9<>"$luna_ctty"; } 2>/dev/null; then
            exec 9<&-
            setsid -c /bin/sh -i -l 0<>"$luna_ctty" 1<>"$luna_ctty" 2<>"$luna_ctty"
        else
            sleep 3600
        fi
    done
}

# curl --interface with an empty $luna_nic swallowed the next option: bind
# to the NIC only when one matched luna.mac. POSIX sh (see _get_luna_ctty).
luna_curl() {
    if [ -n "$luna_nic" ]; then
        curl ${INSECURE:+"$INSECURE"} --interface "$luna_nic" "$@"
    else
        curl ${INSECURE:+"$INSECURE"} "$@"
    fi
}

get_credentials() {
    LUNA_INI='/trinity/local/luna/node/config/luna.ini'
    if [ -f $LUNA_INI ]; then
        API_USERNAME=$(grep USERNAME $LUNA_INI | awk -F '= ' '{ print $2 }')
        if [ "x$API_USERNAME" = "x" ]; then
            API_USERNAME=$(grep USERNAME $LUNA_INI | awk -F '=' '{ print $2 }')
        fi
        API_PASSWORD=$(grep PASSWORD $LUNA_INI | awk -F '= ' '{ print $2 }')
        if [ "x$API_PASSWORD" = "x" ]; then
            API_PASSWORD=$(grep PASSWORD $LUNA_INI | awk -F '=' '{ print $2 }')
        fi
    else
        echo ":"
    fi
    echo "${API_USERNAME}:${API_PASSWORD}"
}

fetch_token() {
    CRED=$(get_credentials)
    USERNAME=$(echo $CRED | awk -F':' '{ print $1 }')
    PASSWORD=$(echo $CRED | awk -F':' '{ print $2 }')
    export TPM2TOOLS_TCTI="device:/dev/tpm0"
    TPM=$(tpm2_pcrread sha256:0 2> /dev/null | grep '0x' | awk -F' : ' '{ print $2 }')
#    if [ "$TPM" == "" ]; then
#        TPM=$(ip a | grep -oE '[0-9a-z]+:[0-9a-z]+:[0-9a-z]+:[0-9a-z]+:[0-9a-z]+:[0-9a-z]+'|grep -v '00:00:00'|tr '\n' ':')
#    fi
    json='{"tpm_sha256":"'$TPM'","username":"'$USERNAME'","password":"'$PASSWORD'"}'
    luna_url=$(getargs luna.url=)
    luna_node=$(getargs luna.node=)
    luna_verifycert=$(getargs luna.verifycert= | tr 'A-Z' 'a-z')
    if [ "$luna_verifycert" == "no" ] || [ "$luna_verifycert" == "false" ]; then
        INSECURE='--insecure'
    fi
    luna_mac=$(getargs luna.mac=)
    luna_nic=$(find_nic "${luna_mac}")
    luna_curl -X POST -H "Content-Type: application/json" -d "$json" -s "${luna_url}/tpm/${luna_node}" > /lunatmp/token.json
    valid=$(grep token /lunatmp/token.json)
    if [ "$valid" ]; then
        token=$(cat /lunatmp/token.json | awk '{ print $2 }' | grep -oE '"(\S+)"')
        token=$(echo "${token:1:-1}")
        echo $token > /lunatmp/token.dat
        echo $token
    else
        >&2 cat /lunatmp/token.json
        >&2 echo
        echo "None"
    fi
}

# lpart leaves the reason for a refused or failed install here. The dracut hook
# (95luna/luna-installer.sh) prints the same file in the same words; keep them in step.
print_failure_reason() {
    [ -s "$LUNA_FAILURE_FILE" ] || return 0
    echo "Luna2: Reason:"
    awk 'NR <= 15 { print "Luna2:   " $0 }' "$LUNA_FAILURE_FILE"
}

if [ "x$ROOT" = "xluna" ]; then
    luna_init
    luna_start
    luna_ctty=$(_get_luna_ctty)
    luna_loghost=$(getargs luna.loghost=)
    luna_url=$(getargs luna.url=)
    luna_node=$(getargs luna.node=)
    luna_service=$(getargs luna.service=)
    luna_verifycert=$(getargs luna.verifycert= | tr 'A-Z' 'a-z')
    if [ "$luna_verifycert" = "no" ] || [ "$luna_verifycert" = "false" ]; then
        INSECURE='--insecure'
    fi
    if [ "x$luna_service" = "x1" ]; then
        echo "Luna2: Entering Service mode."
        setsid -c /bin/sh -i -l 0<>$luna_ctty 1<>$luna_ctty 2<>$luna_ctty
    else
        RES="failure"
        luna_mac=$(getargs luna.mac=)
        luna_nic=$(find_nic ${luna_mac})
        while [ "x$RES" = "xfailure" ]; do
            echo "Luna2: Trying to get install script."
            while [ 0 ]; do
                token=$(fetch_token)
                luna_curl -f -s -m 60 --connect-timeout 10 -H "x-access-tokens: $token" "${luna_url}/boot/install/${luna_node}" -o /lunatmp/install.sh -w "%{http_code}" > /lunatmp/http_code.out
                http_code=$(cat /lunatmp/http_code.out)
                if [ "$http_code" = "200" ]; then
                    break
                else
                    echo "Luna2: Could not get install script [$http_code]. Sleeping 10 sec."
                    sleep 10
                fi
            done
            rm -f "$LUNA_FAILURE_FILE" "$LUNA_SANITIZE_MARKER"
            /bin/bash /lunatmp/install.sh
            rc=$?
            [ "$rc" = "0" ] && RES="success"
            echo "Luna2: install.sh exit status: $RES (rc=$rc)"
            if [ -f "$LUNA_SANITIZE_MARKER" ]; then
                luna_sanitize_stop "$rc"   # never returns
            fi
            if [ "$RES" != "success" ] && { [ "$rc" = "$LUNA_SAFETY_RC" ] || [ "$rc" = "$LUNA_FATAL_RC" ]; }; then
                fatal_park "$rc"           # never returns
            fi
            if [ "$RES" != "success" ] && [ "$luna_loghost" ]; then
                logger -d -n "$luna_loghost" -P 514 < /tmp/luna_install.log
                echo -n '' > /tmp/luna_install.log
            fi
            if [ "$RES" != "success" ]; then
                print_failure_reason
                echo "Luna2: Exit ${rc}: a retryable failure; the reason is above. Retrying in 10s."
            fi
            sleep 10
        done
    fi
    luna_finish
    echo 'Exit from Luna2 Installer'
fi


# --------------- yes, below } is to capture the output --------------------
} 2>&1 | tee -a /tmp/luna_install.log
# --------------------------------------------------------------------------
