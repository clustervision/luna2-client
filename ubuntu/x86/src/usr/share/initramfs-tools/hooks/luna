#!/bin/sh

. /usr/share/initramfs-tools/hook-functions
LUNA_FILES=/usr/share/initramfs-tools/hooks/luna_files

PREREQ=""
prereqs()
{
   echo "$PREREQ"
}

case $1 in
prereqs)
   prereqs
   exit 0
   ;;
esac

mkdir -p "${DESTDIR}/luna"
#copy_exec $LUNA_FILES/ltorrent-client /luna
copy_exec /usr/bin/setsid /usr/bin
copy_exec /usr/bin/curl /usr/bin
copy_exec /usr/bin/awk /usr/bin
copy_exec /usr/bin/tar /usr/bin
copy_exec /usr/sbin/sshd /usr/sbin
# dropbear is the installer's ssh server; without it luna-start falls back to sshd
if [ -x /usr/sbin/dropbear ]; then copy_exec /usr/sbin/dropbear /usr/sbin; fi
copy_exec /usr/bin/file /usr/bin
copy_exec /usr/bin/bash /bin
copy_exec /usr/bin/bash /usr/bin
copy_exec /usr/sbin/chroot /usr/sbin
copy_exec /usr/bin/logger /usr/bin

# efi support
copy_exec /usr/sbin/mkfs.ext4 /usr/sbin
copy_exec /usr/sbin/mkfs.xfs /usr/sbin
copy_exec /usr/sbin/mkfs.vfat /usr/sbin
copy_exec /usr/sbin/parted /usr/sbin
copy_exec /usr/bin/efibootmgr /usr/bin

# advanced local disk support
copy_exec /usr/bin/wc /usr/bin
copy_exec /usr/sbin/mkswap /usr/sbin
copy_exec /usr/sbin/swapon /usr/sbin
copy_exec /usr/sbin/swaplabel /usr/sbin
copy_exec /usr/sbin/mkfs.fat /usr/sbin
copy_exec /usr/sbin/mkdosfs /usr/sbin
copy_exec /usr/sbin/dosfslabel /usr/sbin
copy_exec /usr/sbin/fatlabel /usr/sbin
copy_exec /usr/sbin/mdadm /usr/sbin
# lpart's lvm builder makes LV nodes itself (--noudevsync): vgmknodes, then dmsetup mknodes
for _d in /usr/sbin /sbin; do
    if [ -e "$_d/vgmknodes" ]; then copy_exec "$_d/vgmknodes" /usr/sbin; break; fi
done
copy_exec /usr/bin/top /usr/bin
copy_exec /usr/sbin/fdisk /usr/sbin
copy_exec /usr/bin/lspci /usr/bin
copy_exec /usr/bin/lsblk /usr/bin
copy_exec /usr/bin/lsscsi /usr/bin
copy_exec /usr/bin/tee /usr/bin
copy_exec /usr/bin/lbzip2 /usr/bin
copy_exec /usr/bin/tpm2_pcrread /usr/bin
copy_exec /usr/sbin/sgdisk /usr/sbin
copy_exec /usr/sbin/partprobe /usr/sbin
copy_exec /usr/sbin/wipefs /usr/sbin
copy_exec /usr/sbin/blkid /usr/sbin
copy_exec /usr/sbin/pvcreate /usr/sbin
copy_exec /usr/sbin/vgcreate /usr/sbin
copy_exec /usr/sbin/lvcreate /usr/sbin
copy_exec /usr/sbin/lvchange /usr/sbin
copy_exec /usr/sbin/vgremove /usr/sbin
copy_exec /usr/sbin/pvremove /usr/sbin
copy_exec /usr/sbin/lvremove /usr/sbin
copy_exec /usr/sbin/vgchange /usr/sbin
copy_exec /usr/sbin/pvs /usr/sbin
copy_exec /usr/sbin/vgs /usr/sbin
copy_exec /usr/sbin/lvs /usr/sbin
copy_exec /usr/sbin/dmsetup /usr/sbin
copy_exec /usr/bin/jq /usr/bin
copy_exec /usr/bin/findmnt /usr/bin
copy_exec /usr/bin/dirname /usr/bin
copy_exec /usr/bin/cut /usr/bin
copy_exec /usr/bin/readlink /usr/bin
copy_exec /usr/bin/sort /usr/bin
copy_exec /usr/bin/xargs /usr/bin
copy_exec /usr/bin/mount /usr/bin
copy_exec /usr/bin/umount /usr/bin
copy_exec /usr/bin/sleep /usr/bin
copy_exec /usr/bin/udevadm /usr/bin
copy_exec /usr/bin/env /usr/bin
copy_exec /usr/bin/mktemp /usr/bin
copy_exec /usr/bin/date /usr/bin
copy_exec /usr/bin/hostname /usr/bin
copy_exec /usr/bin/chown /usr/bin

for executable in /usr/bin/base64 /usr/bin/tpm2 /usr/bin/tpm2_pcrread /usr/bin/aria2c /usr/sbin/dmidecode; 
do
    if [ -x $executable ]; then
        path=$(dirname $executable || echo '/usr/bin')
        copy_exec $executable $path
    fi
done

if [ -x /usr/bin/lbzip2 ]; then
    copy_exec /usr/bin/lbzip2 /usr/bin
elif [ -x /usr/bin/bzip2 ]; then
    copy_exec /usr/bin/bzip2 /usr/bin
else
    echo "Error: Either lbzip2 or bzip2 must be installed."
fi

# Note: $HOME is set to / in Debian ramdisk
copy_file config $LUNA_FILES/ashrc /.ashrc
copy_file config $LUNA_FILES/profile /.profile
# ~root rather than /root, just in case somebody decides to use /home/root
# or something like that
copy_file config ~root/.ssh/authorized_keys /.ssh/authorized_keys

copy_file config $LUNA_FILES/passwd /etc/passwd
copy_file config $LUNA_FILES/group /etc/group
copy_file config $LUNA_FILES/sshd_config /etc/ssh/sshd_config
copy_file config /etc/ssh/ssh_host_rsa_key
copy_file config /etc/ssh/ssh_host_ecdsa_key
copy_file config /etc/ssh/ssh_host_ed25519_key
copy_file config /etc/pki/tls/certs/ca-bundle.crt
copy_file config /etc/resolv.conf
copy_file config /trinity/local/luna/node/config/luna.ini
copy_file library /usr/lib/x86_64-linux-gnu/libtss2-tcti-device.so.0

if [ -x /usr/bin/grepcidr ]; then
    copy_exec /usr/bin/grepcidr /usr/bin
else
   echo "Error: grepicdr must be installed!"
   exit 1
fi

# Filesystem checkers for lpart's health probe (lpart-storage-check requires
# e2fsck, xfs_repair and fsck.vfat or fsck.fat) and blkdiscard for
# install_mode=sanitize. /usr/sbin on a merged-/usr image, /sbin before that.
for _tool in e2fsck fsck.ext4 xfs_repair fsck.fat fsck.vfat blkdiscard; do
    _found=""
    for _dir in /usr/sbin /sbin; do
        if [ -x "$_dir/$_tool" ]; then
            copy_exec "$_dir/$_tool" /usr/sbin
            _found=1
            break
        fi
    done
    [ -n "$_found" ] || echo "W: luna hook: $_tool not found; not in the install initramfs"
done

# glibc gconv modules for fsck.fat/fsck.vfat: dosfstools converts FAT short
# names through iconv (codepage 437; IBM850 for mkfs.vfat labels). Without
# them every ESP check fails "CP437: Invalid argument" and lpart judges every
# healthy UEFI os set broken. Debian multiarch paths; gconv-modules.d holds
# the IBM437/IBM850 entries on newer glibc.
for _gconv in /usr/lib/x86_64-linux-gnu/gconv /usr/lib/aarch64-linux-gnu/gconv; do
    [ -d "$_gconv" ] || continue
    for _f in "$_gconv/gconv-modules" "$_gconv/gconv-modules.cache" \
              "$_gconv/IBM437.so" "$_gconv/IBM850.so" "$_gconv"/gconv-modules.d/*.conf; do
        if [ -e "$_f" ]; then
            copy_file gconv "$_f"
        fi
    done
done

# Advanced partitioner (lpart). Copied in here the same way every other tool is:
# whichever builder packs this image, the lpart binaries reach the initramfs through
# that builder's own integration. Each is optional -- an image built without the
# lpart package simply does not get them, and install_mode=legacy never calls them.
for _lpart in lpart-node-installer lpart-storage-prepare lpart-storage-check \
              lpart-osimage-install lpart-bootloader-finalise lpart-emit \
              lpart-tui lpart-phase; do
    if [ -x "/usr/bin/${_lpart}" ]; then
        copy_exec "/usr/bin/${_lpart}" /usr/bin
    fi
done

exit 0
